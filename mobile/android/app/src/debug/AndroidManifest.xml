<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Yalnızca debug build type'ta birleştirilir (release manifest'i ETKİLEMEZ).
         Lokal geliştirme sırasında Android emulator'ün host makineye erişim
         adresi olan 10.0.2.2 gibi HTTP hedeflere (dart-define ile verilen
         API_BASE_URL) bağlanabilmek için; ana manifest'teki
         android:usesCleartextTraffic="false" release'de aynen korunur. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic">
        <!-- Geliştirme yapısından Crashlytics'e hiçbir şey gitmez: Dart
             tarafı da kapatır (lib/core/crash/firebase_crash_reporter.dart),
             bu ayar Dart başlamadan önceki anı da kapsar. -->
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false"/>
    </application>
</manifest>
