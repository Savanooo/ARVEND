# Tarayicinin ulastigi public API koku. NEXT_PUBLIC_* oldugu icin `next build`
# sirasinda bundle'a gomulur -- uretimde build bu degerle calistirilmali.
# Uretim: https://app.arvendyapi.com.tr (gateway /api/* -> Go API)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Next.js sunucu surecinin (Server Component) ulastigi API koku; runtime'da
# okunur. Uretimde Go API ile ayni makinede oldugundan loopback. Bos birakilirsa
# NEXT_PUBLIC_API_URL kullanilir.
INTERNAL_API_URL=http://127.0.0.1:8080
