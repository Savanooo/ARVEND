# Dinleme adresi. Uretimde gateway arkasinda YALNIZ loopback; verilmezse
# ":"+PORT ile tum arayuzlerde dinler (yerel gelistirme).
LISTEN_ADDR=127.0.0.1:8080
PORT=8080

DB_URL=postgres://kullanici@localhost:5432/arvend_dev?sslmode=disable
JWT_SECRET=gelistirme-icin-uzun-rastgele-bir-deger-uretin

# Ayarlar tablosundaki hassas alanlar (SMTP sifresi vb.) icin AES-GCM anahtari.
# Zorunlu; base64 32 byte: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# Uretimde COOKIE_SECURE=true; COOKIE_DOMAIN bos birakilirsa host-only cookie.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Tarayicidan cross-origin cagriya izin verilen origin'ler (virgulle ayrilmis).
# Ayni-origin gateway arkasinda devreye girmez; yerel :3000 -> :8080 icin gerekir.
CORS_ORIGINS=http://localhost:3000

# E-postayla gonderilen paylasim/ek-is linklerinin koku (Next.js adresi).
FRONTEND_URL=http://localhost:3000

# Yuklenen dosyalarin kok dizini.
STORAGE_ROOT=./var/uploads

# Ilk admin kullanici -- sistemde hic kullanici yoksa otomatik olusturulur
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=degistir-bunu-123
SEED_ADMIN_FULLNAME=Yonetici

# Gece 00:05 (Europe/Istanbul) tedarikci fiyat listesi (Ulas, Demir Profil) senkronu.
# Varsayilan acik; yalnizca "otomatik senkron"u acik firmalar senkronlanir,
# birden cok instance olsa da veritabani kilidiyle tek sefer calisir.
# Kapatmak icin: off
PRICE_SYNC_SCHEDULER=on
